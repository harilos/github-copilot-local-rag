@startuml
!pragma layout smetana

title コピーしたら、あとはRAGと日本語で頼むだけ

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontName "Noto Sans JP"
skinparam defaultFontSize 15
skinparam titleFontSize 24
skinparam titleFontStyle bold
skinparam ArrowColor #52606D
skinparam ArrowFontColor #364152
skinparam ArrowFontSize 12
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam actorBorderColor #52606D
skinparam actorFontColor #202938
skinparam rectangleBorderColor #52606D
skinparam rectangleFontColor #202938
skinparam folderBorderColor #9A6700
skinparam folderFontColor #202938
skinparam artifactBorderColor #52606D
skinparam artifactFontColor #202938
skinparam noteBorderColor #8A94A6
skinparam noteBackgroundColor #F7F8FA
skinparam noteFontColor #202938

frame "1. 導入" as Install {
  folder "<b>配布フォルダ rag/</b>\n.copilot/\ninstall.sh\ninstall.ps1" as Distribution #FFF4DE

  rectangle "<b>インストーラーを実行</b>\nmacOS / Linux: install.sh\nWindows: install.ps1" as Installer #E7F6EF

  rectangle "<b>手動コピーの場合</b>\n既存の$HOME/.copilotを削除せず\n.copilotの中身だけをマージ" as Manual #F1F3F5

  frame "$HOME/.copilot/ へマージコピー" as CopilotHome {
    artifact "<b>skills/local-rag/</b>\nSKILL.md\n/local-ragを手動起動" as SlashSkill #DDEBFF
    artifact "<b>rag/query/</b>\nskill_runner.py\n公開検索だけを固定実行" as Runner #F1F3F5
    folder "<b>rag/</b>\nREADME・query・gen_db\nDB・model・docs" as RagHome #FFF4DE
    SlashSkill -[hidden]right- Runner
    Runner -[hidden]right- RagHome
  }

  Distribution --> Installer : 隠し.copilotも含む
  Installer --> SlashSkill
  Installer --> Runner
  Installer --> RagHome
  Installer -[hidden]right- Manual
  Manual ..> SlashSkill
  Manual ..> Runner
  Manual ..> RagHome
}

actor "利用者" as User
rectangle "<b>Copilot組み込みAgent mode</b>\n/local-rag Skillを読み\n承認後に固定runnerを実行" as Agent #E8F1FF

SlashSkill --> Agent : 操作ルール
Runner --> Agent : 固定command境界
RagHome --> Agent : README・実行ファイル
User --> Agent : /local-ragで依頼

frame "2. 利用者が言うこと" as Commands {
  rectangle "<b>インストーラーを実行</b>\nquery/setup.py\n→ venv・依存・ONNXモデル準備\n→ list_dbs.pyで確認" as Setup #E7F6EF

  rectangle "<b>「/local-rag project-ragで〈質問〉」</b>\n必要時だけDB一覧を確認\n→ skill_runner.py search\n→ 本文・出典を使って回答" as Search #DDEBFF

  rectangle "<b>Local RAG Manager</b>\nDB・Sourceの作成、更新、再開\n進捗と完了状態を画面で確認" as Build #FFF4DE

  rectangle "<b>ヘルプとDB一覧</b>\nREADME・Local RAG Manager\n必要時だけlist操作\n検索前にモデルはロードしない" as Help #F1F3F5

  Setup -[hidden]right- Search
  Setup -[hidden]down- Build
  Search -[hidden]down- Help
  Build -[hidden]right- Help
}

Agent --> Setup
Agent --> Search
Agent --> Build
Agent --> Help

legend bottom
  <b>利用者が選ばなくてよいもの</b>
  Vector / BM25 / Exact / RRFなどの検索戦略
  ----
  <b>確認が必要な場合</b>
  DBを一意に選べない場合
  既存DBへ上書きする可能性がある場合
endlegend

@enduml
